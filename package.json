{
  "name": "mf-dashboard-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local, read-only MCP server for hiroppy/mf-dashboard",
  "license": "MIT",
  "bin": {
    "mf-dashboard-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm test && pnpm typecheck && pnpm format:check",
    "dev": "tsx src/index.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "oxfmt": "0.65.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.24.0"
}
